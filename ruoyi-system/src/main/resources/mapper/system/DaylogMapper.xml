<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.DaylogMapper">
    
    <resultMap type="Daylog" id="DaylogResult">
        <result property="id"    column="id"    />
        <result property="text"    column="text"    />
        <result property="time"    column="time"    />
        <result property="topicid"    column="topicid"    />
        <result property="archived"    column="archived"    />
    </resultMap>

    <sql id="selectDaylogVo">
        select id, text, time, topicid, archived from daylog
    </sql>

    <select id="selectDaylogList" parameterType="Daylog" resultMap="DaylogResult">
        <include refid="selectDaylogVo"/>
        <where>  
            <if test="text != null  and text != ''"> and text = #{text}</if>
            <if test="time != null "> and time = #{time}</if>
            <if test="topicid != null "> and topicid = #{topicid}</if>
            <!-- 默认只查询未归档的数据 -->
            and (archived is null or archived = 0)
        </where>
        order by time asc
    </select>

    <select id="selectDaylogAll" resultMap="DaylogResult">
        <include refid="selectDaylogVo"/>
        order by time desc
    </select>
    
    <select id="selectDaylogById" parameterType="Long" resultMap="DaylogResult">
        <include refid="selectDaylogVo"/>
        where id = #{id}
    </select>

    <insert id="insertDaylog" parameterType="Daylog" useGeneratedKeys="true" keyProperty="id">
        insert into daylog
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="text != null">text,</if>
            <if test="time != null">time,</if>
            <if test="topicid != null">topicid,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="text != null">#{text},</if>
            <if test="time != null">#{time},</if>
            <if test="topicid != null">#{topicid},</if>
        </trim>
    </insert>

    <update id="updateDaylog" parameterType="Daylog">
        update daylog
        <trim prefix="SET" suffixOverrides=",">
            <if test="text != null">text = #{text},</if>
            <if test="time != null">time = #{time},</if>
            <if test="topicid != null">topicid = #{topicid},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteDaylogById" parameterType="Long">
        delete from daylog where id = #{id}
    </delete>

    <delete id="deleteDaylogByIds" parameterType="String">
        delete from daylog where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <!-- 归档单个日报 -->
    <update id="archiveDaylogById" parameterType="Long">
        update daylog set archived = 1 where id = #{id}
    </update>

    <!-- 批量归档日报 -->
    <update id="archiveDaylogByIds" parameterType="String">
        update daylog set archived = 1 where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

    <!-- 查询已归档的日报列表 -->
    <select id="selectArchivedDaylogList" parameterType="Daylog" resultMap="DaylogResult">
        <include refid="selectDaylogVo"/>
        <where>  
            <if test="text != null  and text != ''"> and text = #{text}</if>
            <if test="time != null "> and time = #{time}</if>
            <if test="topicid != null "> and topicid = #{topicid}</if>
            <!-- 只查询已归档的数据 -->
            and archived = 1
        </where>
        order by time asc
    </select>

    <!-- 恢复单个日报 -->
    <update id="restoreDaylogById" parameterType="Long">
        update daylog set archived = 0 where id = #{id}
    </update>

    <!-- 批量恢复日报 -->
    <update id="restoreDaylogByIds" parameterType="String">
        update daylog set archived = 0 where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>
</mapper>